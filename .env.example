# Luckout environment. Copy to `.env` at the repo root for local development.
# On the VM the server reads its own `.env`; on Vercel, set the NEXT_PUBLIC_* values as project variables.
# Never commit `.env`.

# ---------- Server (apps/server) ----------
# Leave empty locally to use PGlite (Postgres in-process, no install needed).
DATABASE_URL=
PORT=8787
# Optional: the address to listen on. The VM sets 127.0.0.1 (deploy/ecosystem.config.cjs), so only nginx reaches the server.
HOST=
# Optional: how long a buy request waits for its card before answering "pending", in milliseconds (60000 when unset).
# The page and Telegram follow the purchase from there. Keep it under the proxy's timeout (deploy/README.md).
PURCHASE_REQUEST_WAIT_MS=
# The web app's origin: allowed by CORS, and where links in Telegram messages point.
WEB_ORIGIN=http://localhost:3000
# Optional: more sites allowed to call this server, comma-separated exact origins.
CORS_ORIGINS=
# Signs sessions (at least 32 characters; required on mainnet). Generate with: openssl rand -hex 32
SESSION_SECRET=

# NEAR
NEAR_NETWORK=testnet
# Optional: NEAR RPC endpoints, comma-separated, tried in order when one is rate-limited or down.
# Defaults to free public endpoints for NEAR_NETWORK (FastNEAR, dRPC, then a third).
NEAR_RPC_URL=
LUCKOUT_CONTRACT_ID=
# testnet: our test-USDC token. mainnet: 17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
USDC_CONTRACT_ID=
# The server's account and its function-call key (restricted to purchase_many, settle, purchase, confirm_delivery, fail_purchase).
OPERATOR_ACCOUNT_ID=
OPERATOR_PRIVATE_KEY=
# Optional: the relayer that pays customers' network fees (ADR-0008). A separate account holding
# only gas money, with a full-access key (NEAR requires one to send relayed transactions).
# Unset, customers' wallets pay their own fees.
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
# Optional: the treasury that pays Refills of the Base Float and signs every Base payment through Chain
# Signatures (ADR-0012). A separate account with a full-access key, registered on USDC, that the contract
# owner names with set_treasury. It holds only what refills need. Unset, nothing is refilled or paid from Base.
TREASURY_ACCOUNT_ID=
TREASURY_PRIVATE_KEY=
# NEAR accounts that may open the admin panel (/admin), comma-separated. Everyone else gets "No page here".
# Reserve, proceeds and the shop switch also need the contract owner's own wallet.
ADMIN_ACCOUNTS=

# Optional: low-NEAR alert lines as a percentage of production's (operator and relayer 0.5 NEAR,
# treasury 0.1, contract 1 NEAR free). Staging sets 20.
GAS_ALERT_PERCENT=

# Encrypts Redemption Data at rest (AES-256-GCM). 32 bytes hex: openssl rand -hex 32. Losing it loses stored codes.
REDEMPTION_KEY=

# Bitrefill. On mainnet the API key only reads the catalog and prices (keep its account's credit at $0);
# every order is a guest checkout with our OAuth client (ADR-0012), registered once per deployment at
# https://api.bitrefill.com/oauth/mcp/register with grant_types client_credentials. Testnet buys free
# test cards with the key alone.
BITREFILL_API_KEY=
BITREFILL_API_URL=https://api.bitrefill.com/v2
BITREFILL_CLIENT_ID=
BITREFILL_CLIENT_SECRET=
# When that client's secret expires: client_secret_expires_at from Bitrefill's registration reply (seconds
# since 1970; it lasts 90 days). The server alerts daily from two weeks before. Unset, nothing warns.
BITREFILL_CLIENT_SECRET_EXPIRES_AT=
# Optional: Connect Bitrefill, where customers log in to their own Bitrefill account for higher limits. This
# server's callback, registered exactly with the client above (grant_types authorization_code, refresh_token),
# e.g. https://staging-api.luckout.wtf/bitrefill/callback. Unset, connecting isn't offered.
BITREFILL_REDIRECT_URI=
# Base RPC for our Base wallet (refills swap into it, and every card's Bitrefill invoice is paid from it).
# Required on mainnet, e.g. an Alchemy URL https://base-mainnet.g.alchemy.com/v2/<key>. Testnet defaults to Base Sepolia's public RPC.
BASE_RPC_URL=

# Telegram (from BotFather)
TELEGRAM_BOT_TOKEN=
# Your own chat id, for operator alerts (low gas, stuck purchases, refills). Send /chatid to the bot. Required on mainnet.
ALERT_TELEGRAM_CHAT_ID=

# NEAR AI Cloud (OpenAI-compatible)
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=

# NEAR Intents 1Click (mainnet only)
ONECLICK_API_KEY=
ONECLICK_API_URL=https://1click.chaindefuser.com/v0

# Jupiter, for Top-Ups paid in a Solana token 1Click doesn't take, like ORE (ADR-0014). Unset, no such token is offered.
JUPITER_API_KEY=
# Optional: Jupiter's API (https://api.jup.ag when unset).
JUPITER_API_URL=
# Optional: Solana RPC that simulates each swap and finds Solana Pay payments (public mainnet-beta when unset; production should use its own).
SOLANA_RPC_URL=

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_LUCKOUT_CONTRACT_ID=
NEXT_PUBLIC_USDC_CONTRACT_ID=
# Optional: our public URL, for shared Draw Proof links and Win Cards (https://www.luckout.wtf on production).
# Unset: https://www.luckout.wtf on a Vercel production deployment, the deployment's own Vercel URL on any other, or
# http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=
# Optional: the Reown (WalletConnect) project id EVM wallets connect through. Unset, the one built into the app is used.
NEXT_PUBLIC_REOWN_PROJECT_ID=
