# Luckout environment. Copy to `.env` at the repo root for local development.
# On the VM the server reads its own `.env`; on Vercel, set the NEXT_PUBLIC_* values as project variables.
# Never commit `.env`.

# ---------- Server (apps/server) ----------
# Leave empty locally to use PGlite (Postgres in-process, no install needed).
DATABASE_URL=
PORT=8787
# The web app's origin, for CORS.
WEB_ORIGIN=http://localhost:3000
# Signs Telegram link codes and sessions. Generate with: openssl rand -hex 32
SESSION_SECRET=

# NEAR
NEAR_NETWORK=testnet
# Optional; defaults to the public RPC for NEAR_NETWORK.
NEAR_RPC_URL=
LUCKOUT_CONTRACT_ID=
# testnet: our test-USDC token. mainnet: 17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
USDC_CONTRACT_ID=
# The server's account and its function-call key (restricted to purchase, confirm_delivery, fail_purchase).
OPERATOR_ACCOUNT_ID=
OPERATOR_PRIVATE_KEY=

# Encrypts Redemption Data at rest (AES-256-GCM). 32 bytes hex: openssl rand -hex 32. Losing it loses stored codes.
REDEMPTION_KEY=

# Bitrefill
BITREFILL_API_KEY=
BITREFILL_API_URL=https://api.bitrefill.com/v2

# Telegram (from BotFather)
TELEGRAM_BOT_TOKEN=
# Your own chat id, for operator alerts (low gas, stuck purchases). Send /chatid to the bot.
ALERT_TELEGRAM_CHAT_ID=

# NEAR AI Cloud (OpenAI-compatible)
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=

# NEAR Intents 1Click (mainnet only)
ONECLICK_API_KEY=
ONECLICK_API_URL=https://1click.chaindefuser.com/v0

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_LUCKOUT_CONTRACT_ID=
NEXT_PUBLIC_USDC_CONTRACT_ID=
