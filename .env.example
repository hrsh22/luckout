# Luckout environment. Copy to `.env` at the repo root for local development.
# On the VM the server reads its own `.env`; on Vercel, set the NEXT_PUBLIC_* values as project variables.
# Never commit `.env`.

# ---------- Server (apps/server) ----------
# Leave empty locally to use PGlite (Postgres in-process, no install needed).
DATABASE_URL=
PORT=8787
# The web app's origin: allowed by CORS, and where links in Telegram messages point.
WEB_ORIGIN=http://localhost:3000
# Optional: more sites allowed to call this server, comma-separated exact origins.
CORS_ORIGINS=
# Signs sessions (at least 32 characters; required on mainnet). Generate with: openssl rand -hex 32
SESSION_SECRET=

# NEAR
NEAR_NETWORK=testnet
# Optional: NEAR RPC endpoints, comma-separated, tried in order when one is rate-limited or down.
# Defaults to free public endpoints for NEAR_NETWORK (FastNEAR, dRPC, then a third).
NEAR_RPC_URL=
LUCKOUT_CONTRACT_ID=
# testnet: our test-USDC token. mainnet: 17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
USDC_CONTRACT_ID=
# The server's account and its function-call key (restricted to purchase, confirm_delivery, fail_purchase).
OPERATOR_ACCOUNT_ID=
OPERATOR_PRIVATE_KEY=
# Optional: the relayer that pays customers' network fees (ADR-0008). A separate account holding
# only gas money, with a full-access key (NEAR requires one to send relayed transactions).
# Unset, customers' wallets pay their own fees.
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
# Optional: the treasury that refills our Bitrefill credit (ADR-0009). A separate account with a
# full-access key, registered on USDC, that the contract owner names with set_treasury. It holds
# only what refills need. Unset, credit isn't refilled automatically.
TREASURY_ACCOUNT_ID=
TREASURY_PRIVATE_KEY=
# NEAR accounts that may open the admin panel (/admin), comma-separated. Everyone else gets "No page here".
# Reserve, proceeds and the shop switch also need the contract owner's own wallet.
ADMIN_ACCOUNTS=

# Encrypts Redemption Data at rest (AES-256-GCM). 32 bytes hex: openssl rand -hex 32. Losing it loses stored codes.
REDEMPTION_KEY=

# Bitrefill
BITREFILL_API_KEY=
BITREFILL_API_URL=https://api.bitrefill.com/v2
# Base RPC for our Base wallet (refills swap into it, then pay Bitrefill from it). Required on mainnet,
# e.g. an Alchemy URL https://base-mainnet.g.alchemy.com/v2/<key>. Testnet defaults to Base Sepolia's public RPC.
BASE_RPC_URL=

# Telegram (from BotFather)
TELEGRAM_BOT_TOKEN=
# Your own chat id, for operator alerts (low gas, stuck purchases, refills). Send /chatid to the bot. Required on mainnet.
ALERT_TELEGRAM_CHAT_ID=

# NEAR AI Cloud (OpenAI-compatible)
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=

# NEAR Intents 1Click (mainnet only)
ONECLICK_API_KEY=
ONECLICK_API_URL=https://1click.chaindefuser.com/v0

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_LUCKOUT_CONTRACT_ID=
NEXT_PUBLIC_USDC_CONTRACT_ID=
